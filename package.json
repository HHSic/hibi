{
  "name": "nunsseom",
  "productName": "눈쉼",
  "version": "0.1.4",
  "description": "눈과 몸을 위한 휴식 리마인더 위젯",
  "main": "src/main.js",
  "author": "hyong",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win -p never",
    "release": "electron-builder --win -p always",
    "pack": "electron-builder --win --dir",
    "ship": "node scripts/ship.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "pretendard": "^1.3.9"
  },
  "build": {
    "appId": "com.hyong.nunsseom",
    "productName": "눈쉼",
    "artifactName": "nunsseom-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HHSic",
        "repo": "nunsseom"
      }
    ],
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "눈쉼",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "nunsseom-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.2"
  }
}
